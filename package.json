{
  "name": "reyna-pos",
  "version": "1.0.0",
  "description": "Offline-first Point of Sale for Reyna store",
  "main": "electron/dist/electron/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json --noEmit false && electron .",
    "dev": "concurrently -k -n RENDERER,ELECTRON -c cyan,yellow \"vite\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:all": "npm run build && electron-builder --win --mac",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || true"
  },
  "keywords": [
    "pos",
    "electron",
    "react",
    "sqlite"
  ],
  "author": "Reyna",
  "license": "MIT",
  "dependencies": {
    "@node-escpos/core": "^0.6.0",
    "@node-escpos/usb-adapter": "^0.3.1",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "serialport": "^13.0.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "electron": "^32.3.3",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "wait-on": "^8.0.5"
  }
}
